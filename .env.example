# ============================================================
#  Sentinel X — Environment Configuration
#  Copy this file to .env and fill in your values:
#    cp .env.example .env        (macOS/Linux)
#    copy .env.example .env      (Windows cmd)
#    Copy-Item .env.example .env (Windows PowerShell)
# ============================================================

# ── Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ── API Key (all /api/* requests require this header: X-API-Key: <value>)
# Generate a strong random key:
#   macOS/Linux:  openssl rand -hex 24
#   Windows PS:   -join ((1..24) | % { "{0:x2}" -f (Get-Random -Max 256) })
API_KEY=CHANGE_ME_run_openssl_rand_hex_24

# ── JWT Auth
# Generate: openssl rand -hex 32 (or the PowerShell equivalent above with 32)
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ── PostgreSQL
# Option A — individual variables (default)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sentinelx
DB_USER=sentinelx
DB_PASSWORD=sentinelx
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# Option B — connection string (overrides individual vars above if set)
# DATABASE_URL=postgresql://sentinelx:sentinelx@127.0.0.1:5432/sentinelx

# ── NMAP
# Leave unset to auto-detect: Sentinel X checks PATH, then common install
# locations on your OS (including Program Files on Windows).
# Only set this if auto-detection fails, e.g.:
#   Windows:      NMAP_BINARY=C:\Program Files (x86)\Nmap\nmap.exe
#   macOS/Linux:  NMAP_BINARY=/usr/local/bin/nmap
# Windows install: https://nmap.org/download.html#windows
NMAP_BINARY=
NMAP_OUTPUT_DIR=./reports/nmap
NMAP_MAX_CONCURRENT=3
NMAP_TIMEOUT_MS=300000

# ── CORS
# Comma-separated extra origins to allow beyond localhost/127.0.0.1 of any
# port (which is always allowed). Useful if you open the dashboard from
# another machine on your LAN, e.g.: http://192.168.1.20:3000
CORS_EXTRA_ORIGINS=

# ── Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Logging
LOG_LEVEL=info
LOG_DIR=./logs

# ── Reports
REPORTS_DIR=./reports

# ── Anthropic AI Analyst (optional — platform works without it)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Hashcat (optional — used for GPU-accelerated cracking)
# Same auto-detection as NMAP_BINARY above. Windows build:
# https://hashcat.net/hashcat/
HASHCAT_BINARY=

# ── Wordlists directory
WORDLISTS_DIR=./wordlists
